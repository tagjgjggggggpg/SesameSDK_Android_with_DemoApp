<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="玄関"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wear_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="不明"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/wear_single_state_image"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_marginTop="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wear_unknown_state"
            android:layout_width="132dp"
            android:layout_height="96dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="?\n不明"
            android:textSize="24sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/wear_split_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp">

                    <ImageView
                        android:id="@+id/wear_top_state_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wear_top_unknown"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="?"
                        android:textSize="28sp"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/wear_top_state_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="不明"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下"
                    android:textSize="13sp" />

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp">

                    <ImageView
                        android:id="@+id/wear_bottom_state_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/wear_bottom_unknown"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="?"
                        android:textSize="28sp"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/wear_bottom_state_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="不明"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/wear_action"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:text="操作"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/wear_confirmed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="確認できません"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/wear_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="2"
            android:text=""
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
